extend layout
block content
  div.text-center
    h1= data.facts.full_name
    img(src="profile.jpg", height="300px")
    p
      blockquote(style="display: inline-block;width:auto")
        p #{data.quotes[Math.floor(Math.random()*data.quotes.length)]}
        small A random fact
    each link in data.links
      a(href=link.url).btn
        i(class="#{link.icon}")
        =link.name
        
  div.row.text-center
    div.col-md-6
      h2 About
      div.panel.panel-default.text-left
        div.panel-heading 
          h3.panel-title Welcome
        div.panel-body=data.welcome
      div.panel.panel-default.text-left
        div.panel-heading 
          h3.panel-title JSON
        div.panel-body
          pre.text-left= JSON.stringify(data.facts, null, 4)
 
    div.col-md-6
      h2 Positions
      each position in linkedin.positions.all
        div.panel.panel-primary.text-left
          div.panel-heading
            h3.panel-title #{position.title} - #{position.company.name]
          div.panel-body= position.summary

      h2 Projects
      each project in linkedin.projects.all
        div.panel.panel-success.text-left
          div.panel-heading
             h3.panel-title
               a(href=project.url) #{project.name}
          div.panel-body= project.description
