doctype
html(lang='en')
  head
   title= data.json.full_name 
   meta(charset='utf-8')
   link(href="//maxcdn.bootstrapcdn.com/bootswatch/3.2.0/darkly/bootstrap.min.css", rel="stylesheet")
   link(href="//maxcdn.bootstrapcdn.com/font-awesome/4.2.0/css/font-awesome.min.css", rel="stylesheet")
  body
    .container
     div.row.text-center
      div.col-md-12.text-center
        h1=data.json.full_name
        img(src="profile.jpg" alt=data.json.full_name)
        div
          blockquote(style="display: inline-block;width:auto")
            p#fact #{data.facts[Math.floor(Math.random() * data.facts.length)]}
            small A random fact
  
     div.row.text-center             
      div.col-md-4
        h2 About
        div.panel.panel-warning.text-left
          div.panel-heading 
            h3.panel-title JSON
          div.panel-body
            pre#json.text-left= JSON.stringify(data.json, null, 4)
        div.panel.panel-default.text-left
          div.panel-heading
            h3.panel-title Links
          div.panel-body
            each link in data.links
              div
                a(href=link.url).btn
                  i(class="#{link.icon}")
                  =link.name
        div.panel.panel-info.text-center
          div.panel-heading
            h3.panel-title Bitcoin
          div.panel-body
            p#bitcoin=data.bitcoin
            img(src="https://blockchain.info/qr?data=#{data.bitcoin}&size=200", alt=data.bitcoin)
        
      div.col-md-8
        h2 Positions
        each position in data.positions.all
          div.panel.panel-primary.text-left
            div.panel-heading
              h3.panel-title #{position.title} - #{position.company.name]
            div.panel-body= position.summary
            
  
        h2 Projects
        each project in data.projects.all
          div.panel.panel-success.text-left
            div.panel-heading
               h3.panel-title
                 a(href=project.url) #{project.name}
            div.panel-body= project.description
